# vitals-on-fhir environment configuration
# Copy to .env and fill in real values. Never commit a populated .env.

# Bearer token for all API requests and the dashboard WebSocket. Required for a
# real device. Leave it unset to run in demo mode (mock adapter, no token).
# To set one, uncomment the line below and replace the value with your own secret.
# VOF_API_TOKEN=change-me

# Demo mode (default: true). With no VOF_API_TOKEN, run a mock adapter with
# authentication off and show only simulated data. A real device still needs a
# token. Set to false to make a missing token a startup error (CLI: --no-demo).
VOF_DEMO_MODE=true

# Bind address (default: 127.0.0.1 — loopback only for security)
VOF_HOST=127.0.0.1

# HTTP port
VOF_PORT=8000

# Adapter: mock | mock-bp | mock-spo2 | mock-temp | mock-weight (simulated, work
# in demo mode) or miband10 | bp | spo2 | temp | weight | package.module.ClassName
# (real devices, require VOF_API_TOKEN).
VOF_ADAPTER=mock

# Optional BLE device name filter (leave empty to connect to first matching device)
VOF_DEVICE_NAME=

# Multi-user blood-pressure cuff or scale: the device user (0-254) whose readings
# to record. Readings from other users are rejected. Leave empty for a single-user
# device; a multi-user device's readings are all rejected until this is set.
VOF_DEVICE_USER_ID=

# Mock adapter: seconds between simulated readings. The simulated rhythm is
# chosen with buttons on the dashboard. Also settable in config.yaml.
VOF_MOCK_INTERVAL=1.0

# Device-timestamp interpretation (default: local).
# "local" interprets a device's zoneless timestamp as host local time; set an
# explicit zone (e.g. UTC or an IANA name like America/Phoenix) to override.
VOF_TIMEZONE=local

# Heart-rate plausibility bounds (bpm)
VOF_HR_MIN=20
VOF_HR_MAX=250

# Blood-pressure plausibility bounds (mmHg), per component
VOF_BP_SYSTOLIC_MIN=50
VOF_BP_SYSTOLIC_MAX=250
VOF_BP_DIASTOLIC_MIN=30
VOF_BP_DIASTOLIC_MAX=150

# Oxygen-saturation plausibility bounds (%)
VOF_SPO2_MIN=70
VOF_SPO2_MAX=100

# Body-temperature plausibility bounds (Cel); physical-plausibility, not clinical
VOF_TEMP_MIN=10
VOF_TEMP_MAX=47

# Body-weight plausibility bounds (kg); physical-plausibility, not clinical
VOF_WEIGHT_MIN=2
VOF_WEIGHT_MAX=650

# Local patient identifier (synthetic, not a real patient ID)
VOF_PATIENT_ID=local-patient

# Maximum Observations to keep in memory
VOF_STORE_MAX=10000
